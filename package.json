{
  "name": "knowledgewalk",
  "displayName": "KnowledgeWalk",
  "description": "A reader for LLM-maintained Markdown wikis and Open Knowledge Format (OKF) bundles: front matter cards with sources and trust, citations, link previews, and browser-style navigation.",
  "version": "0.4.0",
  "publisher": "ymatsumoto43",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ymatsumoto/KnowledgeWalk.git"
  },
  "bugs": {
    "url": "https://github.com/ymatsumoto/KnowledgeWalk/issues"
  },
  "homepage": "https://github.com/ymatsumoto/KnowledgeWalk#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#165E83",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:knowledgeWalk.preview",
    "onLanguage:markdown"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "knowledgeWalk.redirect",
        "displayName": "KnowledgeWalk Preview",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "knowledgeWalk.goBack",
        "title": "Back",
        "category": "KnowledgeWalk",
        "icon": "$(arrow-left)",
        "enablement": "knowledgeWalk.canGoBack"
      },
      {
        "command": "knowledgeWalk.goForward",
        "title": "Forward",
        "category": "KnowledgeWalk",
        "icon": "$(arrow-right)",
        "enablement": "knowledgeWalk.canGoForward"
      },
      {
        "command": "knowledgeWalk.switchToEditor",
        "title": "Open in Editor",
        "category": "KnowledgeWalk",
        "icon": "$(edit)"
      },
      {
        "command": "knowledgeWalk.showPreview",
        "title": "Open Preview",
        "category": "KnowledgeWalk",
        "icon": "$(preview)"
      },
      {
        "command": "knowledgeWalk.showPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "KnowledgeWalk",
        "icon": "$(open-preview)"
      },
      {
        "command": "knowledgeWalk.refresh",
        "title": "Refresh Preview",
        "category": "KnowledgeWalk",
        "icon": "$(refresh)"
      },
      {
        "command": "knowledgeWalk.showLog",
        "title": "Show Log",
        "category": "KnowledgeWalk",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "knowledgeWalk.goBack",
          "group": "navigation@1",
          "when": "activeWebviewPanelId == 'knowledgeWalk.preview'"
        },
        {
          "command": "knowledgeWalk.goForward",
          "group": "navigation@2",
          "when": "activeWebviewPanelId == 'knowledgeWalk.preview'"
        },
        {
          "command": "knowledgeWalk.switchToEditor",
          "group": "navigation@3",
          "when": "activeWebviewPanelId == 'knowledgeWalk.preview'"
        },
        {
          "command": "knowledgeWalk.showPreview",
          "group": "navigation@1",
          "when": "editorLangId == markdown"
        }
      ],
      "editor/context": [
        {
          "command": "knowledgeWalk.showPreview",
          "group": "navigation@1",
          "when": "editorLangId == markdown"
        }
      ],
      "explorer/context": [
        {
          "command": "knowledgeWalk.showPreviewToSide",
          "group": "1_knowledgewalk",
          "when": "resourceExtname =~ /^\\.(md|markdown)$/"
        }
      ],
      "webview/context": [
        {
          "command": "knowledgeWalk.switchToEditor",
          "group": "1_edit@1",
          "when": "webviewId == 'knowledgeWalk.preview'"
        },
        {
          "command": "knowledgeWalk.goBack",
          "group": "2_nav@1",
          "when": "webviewId == 'knowledgeWalk.preview' && mdxCanGoBack"
        },
        {
          "command": "knowledgeWalk.goForward",
          "group": "2_nav@2",
          "when": "webviewId == 'knowledgeWalk.preview' && mdxCanGoForward"
        },
        {
          "command": "knowledgeWalk.refresh",
          "group": "2_nav@3",
          "when": "webviewId == 'knowledgeWalk.preview'"
        }
      ],
      "commandPalette": [
        {
          "command": "knowledgeWalk.goBack",
          "when": "activeWebviewPanelId == 'knowledgeWalk.preview'"
        },
        {
          "command": "knowledgeWalk.goForward",
          "when": "activeWebviewPanelId == 'knowledgeWalk.preview'"
        },
        {
          "command": "knowledgeWalk.switchToEditor",
          "when": "activeWebviewPanelId == 'knowledgeWalk.preview'"
        },
        {
          "command": "knowledgeWalk.refresh",
          "when": "activeWebviewPanelId == 'knowledgeWalk.preview'"
        },
        {
          "command": "knowledgeWalk.showPreview",
          "when": "editorLangId == markdown"
        },
        {
          "command": "knowledgeWalk.showPreviewToSide",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "keybindings": [
      {
        "command": "knowledgeWalk.goBack",
        "key": "alt+left",
        "when": "activeWebviewPanelId == 'knowledgeWalk.preview'"
      },
      {
        "command": "knowledgeWalk.goForward",
        "key": "alt+right",
        "when": "activeWebviewPanelId == 'knowledgeWalk.preview'"
      }
    ],
    "configuration": {
      "title": "KnowledgeWalk",
      "properties": {
        "knowledgeWalk.doubleClickToEdit": {
          "type": "boolean",
          "default": true,
          "description": "Double-clicking the preview body closes the preview and opens the file in a text editor at the corresponding line. Disable this if it conflicts with selecting text by double-click."
        },
        "knowledgeWalk.mermaid.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Render ```mermaid fenced code blocks as diagrams."
        },
        "knowledgeWalk.math.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Render $...$ and $$...$$ math with KaTeX."
        },
        "knowledgeWalk.allowRawHtml": {
          "type": "boolean",
          "default": true,
          "description": "Allow raw HTML embedded in Markdown. Output is always sanitized before it is displayed."
        },
        "knowledgeWalk.linkify": {
          "type": "string",
          "enum": [
            "off",
            "urls",
            "all"
          ],
          "default": "urls",
          "enumDescriptions": [
            "Never turn plain text into links.",
            "Only text with an explicit scheme, such as https://example.com.",
            "Also bare domain-like text \u2014 this mistakes filenames such as build.py for hostnames."
          ],
          "description": "Which plain text in a document is turned into links."
        },
        "knowledgeWalk.maxHistoryLength": {
          "type": "number",
          "default": 50,
          "minimum": 2,
          "description": "Maximum number of entries kept in a tab's back/forward history."
        },
        "knowledgeWalk.scrollOffset": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "description": "Pixels of breathing room left above an element when it is scrolled to the top of the preview."
        },
        "knowledgeWalk.reclaimTextEditors": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Turn a Markdown file that opened in a plain text editor into a preview. This covers tabs restored from before KnowledgeWalk was installed, and setups where `#workbench.editorAssociations#` overrides the preview. Files you opened with **KnowledgeWalk: Open in Editor** are left alone."
        },
        "knowledgeWalk.retainHiddenPreviews": {
          "type": "boolean",
          "default": true,
          "description": "Keep a preview loaded while its tab is hidden, so switching back to it is instant. Turn this off to save memory when many previews are open; hidden tabs are then re-rendered on return, and keep their scroll position."
        },
        "knowledgeWalk.frontMatter": {
          "type": "string",
          "enum": [
            "auto",
            "table",
            "hide",
            "source"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Show a metadata card for documents whose front matter has a `type` (OKF and most generated wikis); leave it out otherwise.",
            "Always show the metadata card.",
            "Leave YAML front matter out of the preview.",
            "Show the raw YAML in a code block."
          ],
          "markdownDescription": "How to present the YAML front matter at the top of a document. The card's layout is set by `#knowledgeWalk.frontMatterDisplay#` and by a `.knowledgewalk.yaml` at the wiki root."
        },
        "knowledgeWalk.frontMatterDisplay": {
          "type": "object",
          "default": {},
          "markdownDescription": "How front matter keys are laid out on the metadata card: `header`, `lead`, `hidden`, `details`, `fields` (per key, e.g. `{ \"priority\": { \"as\": \"badge\" } }`) and `byType`. Layered over the built-in OKF defaults; a `frontMatter:` section in `.knowledgewalk.yaml` at the wiki root is layered over this. See the README.",
          "additionalProperties": false,
          "properties": {
            "header": {
              "type": "array",
              "markdownDescription": "Keys shown on the card's first line, in order. `trust` is the verification tier derived from `verified`.",
              "items": {
                "type": "string",
                "examples": [
                  "type",
                  "status",
                  "trust",
                  "generated",
                  "tags",
                  "description"
                ]
              }
            },
            "lead": {
              "type": "string",
              "markdownDescription": "Key shown as the lead paragraph (default `description`)."
            },
            "hidden": {
              "type": "array",
              "markdownDescription": "Keys never shown.",
              "items": {
                "type": "string",
                "examples": [
                  "type",
                  "status",
                  "trust",
                  "generated",
                  "tags",
                  "description"
                ]
              }
            },
            "hideTitleWhenSameAsH1": {
              "type": "boolean",
              "markdownDescription": "Omit `title` when the body's first heading already says the same thing."
            },
            "details": {
              "type": "string",
              "enum": [
                "collapsed",
                "expanded",
                "hidden"
              ],
              "markdownEnumDescriptions": [
                "Remaining keys under a closed *Details* fold.",
                "Remaining keys under an open *Details* fold.",
                "Do not show remaining keys."
              ]
            },
            "fields": {
              "type": "object",
              "markdownDescription": "Display per front matter key, e.g. `{ \"priority\": { \"as\": \"badge\" } }`.",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "as": {
                        "type": "string",
                        "enum": [
                          "auto",
                          "text",
                          "badge",
                          "chips",
                          "date",
                          "link",
                          "links",
                          "table",
                          "template",
                          "sources",
                          "hidden"
                        ],
                        "markdownEnumDescriptions": [
                          "Default for unconfigured keys: a URL or a resolvable path becomes a link, a list becomes chips (or a table when it holds mappings), a mapping a nested list, anything else text.",
                          "Plain text.",
                          "One badge per value, coloured by `colors`; values listed in `hideValues` are skipped.",
                          "One chip per list item.",
                          "The `YYYY-MM-DD` part of a date, as written (no time-zone conversion).",
                          "A link to the path or URL; Markdown targets are labelled with their title.",
                          "A link for each path in a list.",
                          "A table with one row per mapping in a list.",
                          "Fill `template` from the value: `{key}`, `{key.sub}`, `{key|date}`. The result is plain text.",
                          "The OKF source list (the default for `sources`).",
                          "Not shown."
                        ],
                        "markdownDescription": "Display kind."
                      },
                      "colors": {
                        "type": "object",
                        "markdownDescription": "Badge colour per value, e.g. `{ \"high\": \"red\" }`.",
                        "additionalProperties": {
                          "type": "string",
                          "enum": [
                            "red",
                            "orange",
                            "yellow",
                            "green",
                            "blue",
                            "purple",
                            "gray",
                            "none"
                          ]
                        }
                      },
                      "hideValues": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "markdownDescription": "Values not worth a badge, such as the default `stable`."
                      },
                      "template": {
                        "type": "string",
                        "markdownDescription": "For `as: template`: `{key}`, `{key.sub}` and `{key|date}` placeholders. Markup is escaped, never interpreted."
                      },
                      "label": {
                        "type": "string",
                        "enum": [
                          "title",
                          "path"
                        ],
                        "markdownEnumDescriptions": [
                          "Label links to Markdown pages with the page's title.",
                          "Show the path as written."
                        ]
                      }
                    }
                  },
                  {
                    "type": "string",
                    "enum": [
                      "auto",
                      "text",
                      "badge",
                      "chips",
                      "date",
                      "link",
                      "links",
                      "table",
                      "template",
                      "sources",
                      "hidden"
                    ]
                  }
                ],
                "markdownDescription": "How this key's value is drawn. A bare string such as `\"badge\"` is shorthand for `{ \"as\": \"badge\" }`.",
                "defaultSnippets": [
                  {
                    "label": "badge",
                    "body": {
                      "as": "badge",
                      "colors": {
                        "${1:value}": "${2|red,orange,yellow,green,blue,purple,gray,none|}"
                      }
                    }
                  },
                  {
                    "label": "chips",
                    "body": {
                      "as": "chips"
                    }
                  },
                  {
                    "label": "links",
                    "body": {
                      "as": "links"
                    }
                  },
                  {
                    "label": "date",
                    "body": {
                      "as": "date"
                    }
                  },
                  {
                    "label": "template",
                    "body": {
                      "as": "template",
                      "template": "$1"
                    }
                  },
                  {
                    "label": "hidden",
                    "body": {
                      "as": "hidden"
                    }
                  }
                ]
              }
            },
            "byType": {
              "type": "object",
              "markdownDescription": "Overrides for documents of one `type`, layered last, e.g. `{ \"decision\": { \"header\": [\"type\", \"status\", \"owner\"] } }`.",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "header": {
                    "type": "array",
                    "markdownDescription": "Keys shown on the card's first line, in order. `trust` is the verification tier derived from `verified`.",
                    "items": {
                      "type": "string",
                      "examples": [
                        "type",
                        "status",
                        "trust",
                        "generated",
                        "tags",
                        "description"
                      ]
                    }
                  },
                  "lead": {
                    "type": "string",
                    "markdownDescription": "Key shown as the lead paragraph (default `description`)."
                  },
                  "hidden": {
                    "type": "array",
                    "markdownDescription": "Keys never shown.",
                    "items": {
                      "type": "string",
                      "examples": [
                        "type",
                        "status",
                        "trust",
                        "generated",
                        "tags",
                        "description"
                      ]
                    }
                  },
                  "hideTitleWhenSameAsH1": {
                    "type": "boolean",
                    "markdownDescription": "Omit `title` when the body's first heading already says the same thing."
                  },
                  "details": {
                    "type": "string",
                    "enum": [
                      "collapsed",
                      "expanded",
                      "hidden"
                    ],
                    "markdownEnumDescriptions": [
                      "Remaining keys under a closed *Details* fold.",
                      "Remaining keys under an open *Details* fold.",
                      "Do not show remaining keys."
                    ]
                  },
                  "fields": {
                    "type": "object",
                    "markdownDescription": "Display per front matter key, e.g. `{ \"priority\": { \"as\": \"badge\" } }`.",
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "as": {
                              "type": "string",
                              "enum": [
                                "auto",
                                "text",
                                "badge",
                                "chips",
                                "date",
                                "link",
                                "links",
                                "table",
                                "template",
                                "sources",
                                "hidden"
                              ],
                              "markdownEnumDescriptions": [
                                "Default for unconfigured keys: a URL or a resolvable path becomes a link, a list becomes chips (or a table when it holds mappings), a mapping a nested list, anything else text.",
                                "Plain text.",
                                "One badge per value, coloured by `colors`; values listed in `hideValues` are skipped.",
                                "One chip per list item.",
                                "The `YYYY-MM-DD` part of a date, as written (no time-zone conversion).",
                                "A link to the path or URL; Markdown targets are labelled with their title.",
                                "A link for each path in a list.",
                                "A table with one row per mapping in a list.",
                                "Fill `template` from the value: `{key}`, `{key.sub}`, `{key|date}`. The result is plain text.",
                                "The OKF source list (the default for `sources`).",
                                "Not shown."
                              ],
                              "markdownDescription": "Display kind."
                            },
                            "colors": {
                              "type": "object",
                              "markdownDescription": "Badge colour per value, e.g. `{ \"high\": \"red\" }`.",
                              "additionalProperties": {
                                "type": "string",
                                "enum": [
                                  "red",
                                  "orange",
                                  "yellow",
                                  "green",
                                  "blue",
                                  "purple",
                                  "gray",
                                  "none"
                                ]
                              }
                            },
                            "hideValues": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              },
                              "markdownDescription": "Values not worth a badge, such as the default `stable`."
                            },
                            "template": {
                              "type": "string",
                              "markdownDescription": "For `as: template`: `{key}`, `{key.sub}` and `{key|date}` placeholders. Markup is escaped, never interpreted."
                            },
                            "label": {
                              "type": "string",
                              "enum": [
                                "title",
                                "path"
                              ],
                              "markdownEnumDescriptions": [
                                "Label links to Markdown pages with the page's title.",
                                "Show the path as written."
                              ]
                            }
                          }
                        },
                        {
                          "type": "string",
                          "enum": [
                            "auto",
                            "text",
                            "badge",
                            "chips",
                            "date",
                            "link",
                            "links",
                            "table",
                            "template",
                            "sources",
                            "hidden"
                          ]
                        }
                      ],
                      "markdownDescription": "How this key's value is drawn. A bare string such as `\"badge\"` is shorthand for `{ \"as\": \"badge\" }`.",
                      "defaultSnippets": [
                        {
                          "label": "badge",
                          "body": {
                            "as": "badge",
                            "colors": {
                              "${1:value}": "${2|red,orange,yellow,green,blue,purple,gray,none|}"
                            }
                          }
                        },
                        {
                          "label": "chips",
                          "body": {
                            "as": "chips"
                          }
                        },
                        {
                          "label": "links",
                          "body": {
                            "as": "links"
                          }
                        },
                        {
                          "label": "date",
                          "body": {
                            "as": "date"
                          }
                        },
                        {
                          "label": "template",
                          "body": {
                            "as": "template",
                            "template": "$1"
                          }
                        },
                        {
                          "label": "hidden",
                          "body": {
                            "as": "hidden"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "knowledgeWalk.knownFileExtensions": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "pattern": "^\\.?[A-Za-z0-9_+-]+$"
          },
          "markdownDescription": "Extra file extensions, such as `.fasta` or `.drawio`, that mark a front matter value as a file. A value with one of these (or a common extension like `.md`, `.pdf`, `.csv`) that resolves nowhere is flagged as a broken reference; a value with an unfamiliar extension is assumed to be a name."
        },
        "knowledgeWalk.wikiLinks": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Resolve Obsidian-style `[[wiki links]]`, including `[[note|label]]`, `[[note#heading]]` and `![[image.png]]`. A bare name is looked up across the workspace, not just next to the document."
        },
        "knowledgeWalk.wikiRootMarkers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".obsidian"
          ],
          "markdownDescription": "Files or directories whose presence marks a wiki root, used to resolve `[[wiki links]]` when a document has no `root:` in its front matter. Searched upwards from the document."
        },
        "knowledgeWalk.wikiRootKey": {
          "type": "string",
          "default": "root",
          "minLength": 1,
          "markdownDescription": "The front matter key a document uses to name its wiki root, e.g. `root: handbook`. Change it if `root` already means something else in your documents. The key is hidden from the metadata card."
        },
        "knowledgeWalk.wikiLinkFallback": {
          "type": "string",
          "enum": [
            "unique",
            "none"
          ],
          "default": "unique",
          "enumDescriptions": [
            "Look across the whole workspace when a name is not in the document\u2019s own wiki, and accept the match only if exactly one file has that name.",
            "Never resolve a name outside the document\u2019s own wiki."
          ],
          "markdownDescription": "What to do when a `[[wiki link]]` names a note that is not inside the document\u2019s own wiki \u2014 for instance a project that grew links into a neighbouring wiki later."
        }
      }
    },
    "yamlValidation": [
      {
        "fileMatch": ".knowledgewalk.yaml",
        "url": "./media/knowledgewalk.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "vscode:prepublish": "node esbuild.mjs --production",
    "test": "node test/build.mjs && for f in test/dist/*.test.cjs; do node \"$f\" || exit 1; done",
    "package": "vsce package --no-dependencies",
    "package:local": "node esbuild.mjs --production && node scripts/package-vsix.mjs",
    "publish": "vsce publish --no-dependencies",
    "test:integration": "node esbuild.mjs && node test/build-integration.mjs && node test/integration/runTest.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:integration",
    "deploy:devcontainer": "npm run package:local && node scripts/deploy-devcontainer.mjs"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "1.1.2",
    "dompurify": "3.2.4",
    "highlight.js": "11.10.0",
    "js-yaml": "4.1.0",
    "katex": "0.16.11",
    "markdown-it": "14.1.0",
    "markdown-it-anchor": "9.2.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-front-matter": "0.2.4",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "11.4.1"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/markdown-it": "14.1.2",
    "@types/node": "18.19.50",
    "@types/vscode": "1.75.1",
    "@vscode/test-electron": "2.4.1",
    "@vscode/vsce": "2.32.0",
    "esbuild": "0.21.5",
    "typescript": "5.4.5"
  },
  "keywords": [
    "markdown",
    "preview",
    "wiki",
    "wikilinks",
    "agent",
    "ai",
    "llm wiki",
    "llm",
    "obsidian",
    "front matter",
    "yaml",
    "knowledge base",
    "okf",
    "open knowledge format",
    "back",
    "forward",
    "history",
    "documentation"
  ]
}
